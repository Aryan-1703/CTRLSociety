# CTRL Society — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Your Shopify store domain (e.g. ctrlsociety.myshopify.com)
VITE_SHOPIFY_DOMAIN=ctrlsociety.ca

# Storefront API access token
# Get it: Shopify Admin → Settings → Apps → Develop apps
# → Create app → Configuration → Storefront API → enable permissions → Install → copy token
VITE_SHOPIFY_TOKEN=your_storefront_token_here
